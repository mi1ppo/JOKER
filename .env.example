# Скопируйте этот файл в .env (рядом с ним) и заполните ключ. Файл .env в git не попадает.
# Без ключа игра работает: ИИ-функции переходят на резервный контент из chaos_poker/data/.

# Authorization key из личного кабинета GigaChat API (Base64 от "Client ID:Client Secret"), показывается один раз
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_BASE=https://api.giga.chat/v1
# Актуальный список моделей: GET /models (сервер проверяет модель при старте)
GIGACHAT_MODEL=GigaChat-2
# Корневой сертификат Минцифры — только для запросов к GigaChat (путь относительно папки chaos_poker)
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.pem
# false только для отладки: при старте будет предупреждение
GIGACHAT_VERIFY_SSL=true
# Лимит токенов на одну партию (0 = без лимита)
GIGACHAT_TOKEN_BUDGET=200000

# Необязательно: IP ноутбука для QR-кодов, если автоопределение ошиблось
# HOST_IP=192.168.1.25
# Необязательно: публичный адрес туннеля (Cloudflare Tunnel / ngrok) — тогда QR-коды ведут на него
# PUBLIC_URL=https://example.trycloudflare.com
